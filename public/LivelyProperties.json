{
  "lblGroupInterface": {
    "type": "label",
    "value": "Nhóm 1: Giao Diện"
  },
  "showClock": {
    "type": "checkbox",
    "value": true,
    "text": "Hiển thị đồng hồ trung tâm"
  },
  "clock24Hour": {
    "type": "checkbox",
    "value": true,
    "text": "Định dạng 24 giờ"
  },
  "showTrackInfo": {
    "type": "checkbox",
    "value": true,
    "text": "Hiển thị tên bài hát và ca sĩ"
  },
  "showAlbumArt": {
    "type": "checkbox",
    "value": true,
    "text": "Hiển thị ảnh bìa album"
  },
  "showLyrics": {
    "type": "checkbox",
    "value": true,
    "text": "Hiển thị lời bài hát"
  },
  "circleSize": {
    "type": "slider",
    "min": 55,
    "max": 145,
    "step": 5,
    "value": 100,
    "text": "Kích thước vòng tròn (%)"
  },
  "circleOffsetX": {
    "type": "slider",
    "min": -30,
    "max": 30,
    "step": 1,
    "value": 0,
    "text": "Vị trí ngang vòng tròn (%)"
  },
  "circleOffsetY": {
    "type": "slider",
    "min": -30,
    "max": 30,
    "step": 1,
    "value": -4,
    "text": "Vị trí dọc vòng tròn (%)"
  },

  "lblGroupEqualizer": {
    "type": "label",
    "value": "Nhóm 2: Equalizer"
  },
  "eqStyle": {
    "type": "dropdown",
    "value": 0,
    "text": "Kiểu Equalizer",
    "items": [
      "Thanh tròn",
      "Thanh vuông",
      "Chấm LED",
      "Đường sóng",
      "Dạng gai"
    ]
  },
  "barCount": {
    "type": "slider",
    "min": 32,
    "max": 180,
    "step": 4,
    "value": 96,
    "text": "Số lượng thanh"
  },
  "barWidth": {
    "type": "slider",
    "min": 2,
    "max": 14,
    "step": 1,
    "value": 5,
    "text": "Độ dày thanh (px)"
  },
  "barLength": {
    "type": "slider",
    "min": 40,
    "max": 220,
    "step": 5,
    "value": 115,
    "text": "Chiều dài thanh tối đa (px)"
  },
  "barDirection": {
    "type": "dropdown",
    "value": 0,
    "text": "Hướng chuyển động",
    "items": [
      "Hướng ra ngoài",
      "Hướng vào trong",
      "Hai chiều"
    ]
  },
  "rotationDirection": {
    "type": "dropdown",
    "value": 0,
    "text": "Chiều xoay vòng tròn",
    "items": [
      "Theo chiều kim đồng hồ",
      "Ngược chiều kim đồng hồ",
      "Đứng yên"
    ]
  },
  "rotationSpeed": {
    "type": "slider",
    "min": 0,
    "max": 300,
    "step": 5,
    "value": 35,
    "text": "Tốc độ xoay (%)"
  },

  "lblGroupColors": {
    "type": "label",
    "value": "Nhóm 3: Màu Sắc"
  },
  "palette": {
    "type": "dropdown",
    "value": 0,
    "text": "Bảng màu",
    "items": [
      "Neon",
      "Hoàng Hôn",
      "Đại Dương",
      "Đơn Sắc",
      "Vaporwave",
      "Ngọn Lửa",
      "Rừng Xanh",
      "Tự Chọn Màu"
    ]
  },
  "customPrimaryColor": {
    "type": "color",
    "value": "#22D3EE",
    "text": "Màu chính (khi chọn Tự Chọn Màu)"
  },
  "customSecondaryColor": {
    "type": "color",
    "value": "#EC4899",
    "text": "Màu phụ (khi chọn Tự Chọn Màu)"
  },

  "lblGroupBackground": {
    "type": "label",
    "value": "Nhóm 4: Hình Nền"
