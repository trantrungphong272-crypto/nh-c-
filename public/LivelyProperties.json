  },
  "customBackgroundFile": {
    "type": "file",
    "value": "",
    "text": "Chọn ảnh nền cá nhân",
    "filter": "Image files (*.jpg;*.jpeg;*.png;*.webp)|*.jpg;*.jpeg;*.png;*.webp"
  },
  "bgBlur": {
    "type": "slider",
    "min": 0,
    "max": 24,
    "step": 1,
    "value": 2,
    "text": "Độ mờ hình nền (px)"
  },
  "bgDarkness": {
    "type": "slider",
    "min": 0,
    "max": 90,
    "step": 2,
    "value": 38,
    "text": "Độ tối lớp phủ (%)"
