    "type": "checkbox",
    "value": true,
    "text": "Hạt ánh sáng chuyển động"
  },
  "particleDensity": {
    "type": "slider",
    "min": 20,
    "max": 140,
    "step": 4,
    "value": 72,
    "text": "Mật độ hạt ánh sáng"
  },
  "bassPulseEnabled": {
    "type": "checkbox",
    "value": true,
    "text": "Hiệu ứng nhịp bass & sóng xung"
  },
  "flashEnabled": {
    "type": "checkbox",
    "value": false,
    "text": "Hiệu ứng nhấp nháy theo trống"
  },
  "auroraOverlay": {
    "type": "checkbox",
    "value": true,
    "text": "Lớp phủ cực quang"
  },
  "colorShift": {
    "type": "checkbox",
    "value": false,
    "text": "Hiệu ứng chuyển màu động"
  },
  "autoQualityScale": {
    "type": "checkbox",
    "value": true,
    "text": "Tự giảm hiệu ứng khi FPS thấp"
  },

  "lblGroupAudio": {
    "type": "label",
    "value": "Nhóm 6: Âm Thanh"
  },
  "sensitivity": {
    "type": "slider",
    "min": 30,
    "max": 250,
    "step": 5,
    "value": 115,
    "text": "Độ nhạy Equalizer (%)"
  },
  "bassGain": {
    "type": "slider",
    "min": 30,
    "max": 250,
    "step": 5,
    "value": 125,
    "text": "Độ khuếch đại Bass (%)"
  },
  "trebleGain": {
    "type": "slider",
    "min": 30,
    "max": 250,
    "step": 5,
    "value": 105,
    "text": "Độ khuếch đại Treble (%)"
  },
  "smoothness": {
    "type": "slider",
    "min": 10,
    "max": 95,
    "step": 3,
    "value": 68,
    "text": "Độ mượt (%)"
  },
  "fpsLimit": {
    "type": "dropdown",
    "value": 1,
    "text": "Giới hạn FPS",
    "items": [
      "30 FPS",
      "60 FPS"
    ]
  },
  "updateRate": {
    "type": "slider",
    "min": 15,
    "max": 60,
    "step": 5,
    "value": 60,
    "text": "Tần số cập nhật (Hz)"
  },

  "lblGroupLyrics": {
    "type": "label",
